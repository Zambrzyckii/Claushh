# Copies pywal's colors.json and sequences of the user %i into /home/workspace/.cache/wal, where the API reads the
# terminal's colours (Terminal:ThemeFile) and the shell can print the sequences (README.md, "Deployment" → "The
# terminal's colours (pywal)"). Started by claushh-wal-sync@%i.path. It runs as workspace and sees of /home only those
# two directories, the source read-only; each file is written next to its place and then renamed over it, so a reader
# never gets half a file. colors.json goes first, so a missing sequences file cannot keep the colours from the API.
[Unit]
Description=Claushh: copy the pywal colours of %i for the terminal

[Service]
Type=oneshot
User=workspace
Group=workspace
UMask=0022
ExecStart=/usr/bin/install -m 0644 /home/%i/.cache/wal/colors.json /home/workspace/.cache/wal/.colors.json.new
ExecStart=/usr/bin/mv -f /home/workspace/.cache/wal/.colors.json.new /home/workspace/.cache/wal/colors.json
ExecStart=/usr/bin/install -m 0644 /home/%i/.cache/wal/sequences /home/workspace/.cache/wal/.sequences.new
ExecStart=/usr/bin/mv -f /home/workspace/.cache/wal/.sequences.new /home/workspace/.cache/wal/sequences
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/%i/.cache/wal
BindPaths=/home/workspace/.cache/wal
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
