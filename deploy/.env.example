# Variables for deploy/docker-compose.yml. Development: copy to deploy/.env (in .gitignore, never commit it).
# Production: copy to /etc/claushh/compose.env (root, 600) with POSTGRES_PORT=5435.
POSTGRES_DB=claushh
POSTGRES_USER=claushh
POSTGRES_PASSWORD=
# A host port no other PostgreSQL uses.
POSTGRES_PORT=5434
