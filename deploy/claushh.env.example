# Template of /etc/claushh/claushh.env: the install-specific settings and secrets of claushh.service, which systemd
# reads before the service starts (docs/PLAN.md, "Deployment decisions"). Install it as root:root, mode 600:
#   sudo install -m 0600 deploy/claushh.env.example /etc/claushh/claushh.env
# and replace every <...>. Values are single-quoted: systemd and sh read them the same way, and a value with ";"
# stays one value. Use a hex password (openssl rand -hex 32), so nothing in it needs escaping.
ConnectionStrings__Claushh='Host=127.0.0.1;Port=5435;Database=claushh;Username=claushh;Password=<POSTGRES_PASSWORD of /etc/claushh/compose.env>'
AllowedHosts='<domain>'
Hubs__AllowedOrigins__0='https://<domain>'
Notifications__NtfyUrl='https://ntfy.sh/<topic>'
# An ntfy access token (tk_...); empty: none.
Notifications__NtfyToken=''
# Optional, for the console: an Anthropic API key instead of the subscription login, in a file of workspace outside
# /srv/projects (by its real path) with mode 0600, for example under /home/workspace. The API checks both at start;
# otherwise the console is unavailable.
# Console__ApiKeyFile='<path>'
